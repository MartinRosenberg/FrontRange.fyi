---
import { SITE_NAME } from '../lib/site'
import PageMasthead from '../components/PageMasthead.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { render } from 'astro:content'
import { getChangelog } from '../lib/changelog'
import { formatDay, formatMonthShort } from '../lib/dates'

const description = `What's new on ${SITE_NAME} — the running log of updates, newest first.`

const entries = await getChangelog()
const updates = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry)

    return { date: entry.data.date, Content }
  }),
)
---

<BaseLayout crumb="Updates" title={`What's New in ${SITE_NAME}`} description={description}>
  <article>
    <PageMasthead title="What's New">
      <p slot="lede">A running log of what I've added and changed</p>
    </PageMasthead>

    <div class="reading-col">
      <ol class="updates divided-list dated-rows">
        {
          updates.map(({ date, Content }) => (
            <li>
              <time class="date-stamp" datetime={date.toISOString()}>
                <span class="eyebrow eyebrow--muted">{formatMonthShort(date)}</span>
                <span class="date-stamp-day">{formatDay(date)}</span>
              </time>
              <div class="changelog-body">
                <Content />
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </article>
</BaseLayout>

<style>
  .updates > li:first-child {
    padding-block-start: 0;
  }
</style>
