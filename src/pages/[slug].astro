---
import { getCollection, render } from 'astro:content'
import { Image } from 'astro:assets'
import BaseLayout from '../layouts/BaseLayout.astro'
import BoundaryMap from '../components/BoundaryMap.astro'
import Comments from '../components/Comments.astro'
import StreetMap from '../components/StreetMap.astro'
import { streetSpotsByStreet } from '../lib/street-spots'
import { districtBoundaries } from '../lib/districts'
import Entry from '../components/Entry.astro'
import EntryDates from '../components/EntryDates.astro'
import { published } from '../lib/content'
import { getBacklinks } from '../lib/backlinks'
import { articleSchema } from '../lib/schema'
import { href } from '../lib/url'
import { isoDate } from '../lib/dates'
import { neighborhoodInfo, allStreets } from '../lib/neighborhoods'

export async function getStaticPaths() {
  const topics = published(await getCollection('topics'))

  return topics.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { data } = entry
const { Content } = await render(entry)
const backlinks = await getBacklinks(entry.id)

const hasBoundaryMap = (entry.body ?? '').includes('data-boundary-map')
const hasStreetMap = (entry.body ?? '').includes('data-street-map')
const streetSpots = hasStreetMap ? await streetSpotsByStreet() : {}
const streetDistricts = hasStreetMap ? await districtBoundaries() : []
const aboutSlugs = hasStreetMap
  ? [...new Set(allStreets().flatMap((street) => street.neighborhoods))]
  : []

const siteOrigin = Astro.site ?? new URL(Astro.url.origin)
const permalink = new URL(`/${entry.id}/`, siteOrigin).href
const schema = articleSchema(
  {
    title: data.title,
    url: permalink,
    description: data.seoDescription ?? data.description,
    image: new URL(href(data.ogImage ?? '/og.png'), siteOrigin).href,
    published: isoDate(data.created ?? data.updated),
    updated: isoDate(data.updated),
    about: aboutSlugs.flatMap((slug) => {
      const info = neighborhoodInfo(slug)

      return info
        ? [{ name: info.name, url: new URL(`/neighborhoods/${slug}/`, siteOrigin).href }]
        : []
    }),
  },
  siteOrigin,
)
---

<BaseLayout
  article
  crumb={data.title}
  title={data.seoTitle}
  description={data.seoDescription ?? data.description}
  ogImage={data.ogImage}
  ogType="article"
  publishedTime={isoDate(data.created ?? data.updated)}
  modifiedTime={isoDate(data.updated)}
  jsonLd={schema}>
  {hasBoundaryMap && <BoundaryMap />}
  {hasStreetMap && <StreetMap spots={streetSpots} districts={streetDistricts} />}
  <Entry
    title={data.title}
    backlinks={backlinks}
    permalink={permalink}
    eyebrow={data.category}>
    {
      data.description && (
        <p class="p-summary" slot="lede">
          {data.description}
        </p>
      )
    }
    <Fragment slot="footer-meta">
      <EntryDates created={data.created} updated={data.updated} />
    </Fragment>
    <Comments slot="comments" kind="topic" slug={entry.id} title={data.title} />
    <div class:list={['article-col', 'reading-col', { 'compact-article': data.display === 'list' }]}>
      {
        data.photo && data.photoInArticle && (
          <figure class="figure full">
            <Image
              src={data.photo}
              alt={data.photoCaption ?? data.title}
              loading="eager"
              widths={[650, 1300]}
              sizes="(min-width: 700px) 650px, 100vw"
            />
            {data.photoCaption && <figcaption>{data.photoCaption}</figcaption>}
          </figure>
        )
      }
      <Content />
    </div>
  </Entry>
</BaseLayout>

<style>
  .article-col {
    margin-block-start: var(--spacing-md);
  }
</style>
