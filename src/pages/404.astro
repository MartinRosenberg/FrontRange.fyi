---
import PageMasthead from '../components/PageMasthead.astro'
import { getCollection } from 'astro:content'
import { Image } from 'astro:assets'
import BaseLayout from '../layouts/BaseLayout.astro'
import CardList from '../components/CardList.astro'
import Card from '../components/Card.astro'
import Icon from '../components/Icon.astro'
import IconMapPin from '../assets/IconMapPin.astro'
import { href } from '../lib/url'
import { published, hasBody, excerpt, PREVIEW_EXCERPT_CHARS } from '../lib/content'
import { cuisineLabel } from '../lib/cuisine'
import { neighborhoodName } from '../lib/neighborhoods'

const topics = published(await getCollection('topics'))
const pizza = topics.find((topic) => topic.id === 'st-louis-style-pizza')
const regional = topics.find((topic) => topic.id === 'regional-foods')
const field = topics.find((topic) => topic.id === 'field-notes')

const byBodyLength = (left: { body?: string }, right: { body?: string }) =>
  (right.body?.length ?? 0) - (left.body?.length ?? 0)
const restaurants = published(await getCollection('food'))
  .filter(hasBody)
  .sort(byBodyLength)
  .slice(0, 2)
const neighborhoods = published(await getCollection('neighborhoods'))
  .filter(hasBody)
  .sort(byBodyLength)
  .slice(0, 2)
---

<BaseLayout crumb="Not found" title="Page Not Found" noindex>
  <article>
    <PageMasthead title="Page Not Found" wide>
      <p slot="lede">That page doesn't exist (or it moved). Try these:</p>
    </PageMasthead>

    {
      pizza && (
        <a class="feature-box" href={href(`/${pizza.id}/`)}>
          {pizza.data.photo && (
            <Image
              class="feature-box-img"
              src={pizza.data.photo}
              alt={pizza.data.photoCaption ?? pizza.data.title}
              widths={[680, 1360]}
              sizes="(min-width: 600px) 340px, 100vw"
            />
          )}
          <span class="feature-box-body">
            <span class="eyebrow">Featured</span>
            <span class="feature-box-title title-link">{pizza.data.title}</span>
            {pizza.data.description && <span class="description">{pizza.data.description}</span>}
          </span>
        </a>
      )
    }

    {
      regional && field && (
        <CardList title="More reading">
          <Card
            href={href(`/${field.id}/`)}
            title={field.data.title}
            meta="Article"
            description={field.data.description}>
            <Icon name={field.data.icon} slot="icon" />
          </Card>
          <Card
            href={href(`/${regional.id}/`)}
            title={regional.data.title}
            meta="Article"
            description={regional.data.description}>
            <Icon name={regional.data.icon} slot="icon" />
          </Card>
        </CardList>
      )
    }

    {
      restaurants.length > 0 && (
        <CardList title="Restaurants">
          {restaurants.map((place) => (
            <Card
              href={href(`/food/${place.id}/`)}
              title={place.data.title}
              meta={[cuisineLabel(place.data.cuisine[0]), neighborhoodName(place.data.neighborhood)]
                .filter(Boolean)
                .join(' / ')}
              description={place.data.description ?? excerpt(place.body, PREVIEW_EXCERPT_CHARS)}
            />
          ))}
        </CardList>
      )
    }

    {
      neighborhoods.length > 0 && (
        <CardList title="Neighborhoods">
          {neighborhoods.map((hood) => (
            <Card
              href={href(`/neighborhoods/${hood.id}/`)}
              title={hood.data.title}
              meta="Neighborhood"
              description={hood.data.description ?? excerpt(hood.body, PREVIEW_EXCERPT_CHARS)}>
              <IconMapPin slot="icon" />
            </Card>
          ))}
        </CardList>
      )
    }

    <p class="home-link">
      <a href={href('/')}>Back home</a>
    </p>
  </article>

  <style>
    .feature-box {
      margin-block: var(--spacing-lg);
    }

    .home-link {
      margin-block-start: var(--spacing-xl);
    }
  </style>
</BaseLayout>
