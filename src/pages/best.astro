---
import PageMasthead from '../components/PageMasthead.astro'
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import Card from '../components/Card.astro'
import IconArrowRight from '../assets/IconArrowRight.astro'
import ReaderFavorites from '../components/ReaderFavorites.astro'
import { published, excerpt, META_DESCRIPTION_CHARS } from '../lib/content'
import { href } from '../lib/url'
import { CITY, SUPABASE_ENABLED } from '../lib/site'
import { optionalData } from '../lib/optional-data'

interface Award {
  label: string
  slug: string
}

const BEST_EXCERPT_CHARS = 280
const food = published(await getCollection('food'))
const foodBySlug = new Map(food.map((place) => [place.id, place]))
const bestFoodPicks = optionalData<Award[]>(
  import.meta.glob('../data/best-food.json', { eager: true, import: 'default' }),
  [],
)
const resolvedAwards = bestFoodPicks.flatMap((award) => {
  const place = foodBySlug.get(award.slug)

  return place ? [{ ...award, place, teaser: excerpt(place.body ?? '', BEST_EXCERPT_CHARS) }] : []
})

const awards = [
  ...resolvedAwards.filter((award) => award.place.data.photo),
  ...resolvedAwards.filter((award) => !award.place.data.photo),
]

const readersEnabled = SUPABASE_ENABLED

const descriptionLead = `My picks for the best food in ${CITY}, by category: `
const descriptionSuffix = ', and more.'
const fittingLabels: string[] = []
for (const award of resolvedAwards) {
  const candidate = [...fittingLabels, award.label].join(', ')
  if (
    descriptionLead.length + candidate.length + descriptionSuffix.length >
    META_DESCRIPTION_CHARS
  ) {
    break
  }
  fittingLabels.push(award.label)
}
const description = `${descriptionLead}${fittingLabels.join(', ')}${descriptionSuffix}`
---

<BaseLayout crumb="Best of" title={`The Best Food in ${CITY}`} description={description}>
  <article>
    <PageMasthead title={`The Best Food in ${CITY}`} wide>
      <p slot="lede">
        {`My top restaurants${readersEnabled && " and community voted favorites"}`}
      </p>
    </PageMasthead>

    <div class:list={[{ 'detail-layout detail-layout--wide': readersEnabled }]}>
      <div class="detail-main">
        <div class="best-list">
          {
            awards.map(({ label, place, teaser }) => (
              <section class="best-entry">
                <Card
                  class="card--lg card--xl card--side-photo"
                  accentMeta
                  meta={label}
                  href={href(`/food/${place.id}/`)}
                  title={place.data.title}
                  description={place.data.description}
                  excerpt={teaser}
                  photo={place.data.photo}
                  photoSizes="(min-width: 1000px) 320px, 100vw">
                  <span class="continue-link">
                    Continue reading <IconArrowRight />
                  </span>
                </Card>
              </section>
            ))
          }
        </div>
      </div>

      {
        readersEnabled && (
          <aside class="detail-aside">
            <ReaderFavorites />
          </aside>
        )
      }
    </div>
  </article>
</BaseLayout>

<style>
  .best-list {
    container-type: inline-size;
  }

  .best-entry {
    padding-block: var(--spacing-xl);
    border-block-end: 1px solid var(--color-line);
  }

  .best-entry:first-child {
    padding-block-start: 0;
  }

  .best-entry:last-child {
    border-block-end: 0;
  }
</style>
