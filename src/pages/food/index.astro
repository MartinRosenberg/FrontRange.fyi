---
import { CITY, SUPABASE_ENABLED } from '../../lib/site'
import { getCollection } from 'astro:content'
import { getImage } from 'astro:assets'

import BaseLayout from '../../layouts/BaseLayout.astro'
import FilterMapPage from '../../components/FilterMapPage.astro'
import CityMap from '../../components/CityMap.astro'
import ListPaneHeader from '../../components/ListPaneHeader.astro'
import MapRow from '../../components/MapRow.astro'
import PaneSearch from '../../components/PaneSearch.astro'
import PaneSort from '../../components/PaneSort.astro'
import Rating from '../../components/Rating.astro'
import { published, hasBody, excerpt, foodStatus, PREVIEW_EXCERPT_CHARS } from '../../lib/content'
import { cuisineLabel, cuisineLegendItems } from '../../lib/cuisine'
import { googleMapsHref } from '../../lib/maps'
import { toMapSpots } from '../../lib/map-spots'
import { itemListSchema } from '../../lib/schema'
import { neighborhoodName, neighborhoodPopups } from '../../lib/neighborhoods'
import { resolveVerdict, type Verdict } from '../../lib/verdict'

const verdictRankLetter: Record<Verdict, string> = {
  loved: 'a',
  liked: 'b',
  neutral: 'c',
  'not-for-me': 'd',
}
const statusRankLetter: Record<'tried' | 'want-to-try', string> = {
  tried: 'e',
  'want-to-try': 'f',
}

const all = published(await getCollection('food'))

const rows = (
  await Promise.all(
    all.map(async (place) => {
      const verdict = resolveVerdict(place.data)
      const groupKey = verdict ?? foodStatus(place)
      const rankLetter = verdict
        ? verdictRankLetter[verdict]
        : (statusRankLetter[foodStatus(place) as keyof typeof statusRankLetter] ?? 'h')
      const thumb = place.data.photo
        ? await getImage({ src: place.data.photo, width: 480, format: 'webp' })
        : undefined

      return { place, verdict, groupKey, rankLetter, thumb }
    }),
  )
).sort((left, right) =>
  `${left.rankLetter}|${left.place.data.title}`.localeCompare(
    `${right.rankLetter}|${right.place.data.title}`,
  ),
)

const count = rows.length
const cuisines = [...new Set(rows.flatMap((entry) => entry.place.data.cuisine))].sort((left, right) =>
  cuisineLabel(left).localeCompare(cuisineLabel(right)),
)

const mapSpots = await toMapSpots(
  [],
  rows.map((entry) => entry.place),
  { filterChips: true, cuisineIcons: true },
)
const areas = await neighborhoodPopups()

const description = [
  `An interactive map of ${CITY} restaurants and cafes, filterable by cuisine and neighborhood.`,
  SUPABASE_ENABLED ? 'Each place is rated by me and reviewed by the community.' : 'Each place is rated by me.',
].join(' ')

const siteOrigin = Astro.site ?? new URL(Astro.url.origin)
const schema = itemListSchema(
  `${CITY} Food Map`,
  rows.map(({ place }) => ({
    name: place.data.title,
    url: new URL(`/food/${place.id}/`, siteOrigin).href,
  })),
)
---

<BaseLayout
  title={`${CITY} Food Map: Restaurants, Bars, and Cafes`}
  description={description}
  ogImage="/og/food-og.png"
  jsonLd={schema}>
  <FilterMapPage emptyText="No places match those filters.">
    <article class="content-pane map-list grouped-list">
      <ListPaneHeader title="Food" count={count} live>
        <PaneSearch label="Search places" placeholder="search by name, cuisine..." />
        <PaneSort
          options={[
            { label: 'Rating', value: 'verdict:asc' },
            { label: 'A–Z', value: 'name:asc' },
          ]}
        />
      </ListPaneHeader>
      <ul class="list" data-grouped-rows>
        {
          rows.map(({ place, verdict, groupKey, rankLetter, thumb }) => (
            <MapRow
              id={place.id}
              title={place.data.title}
              detailHref={`/food/${place.id}/`}
              readMore={false}
              viewMore={hasBody(place)}
              websiteHref={place.data.url}
              directionsHref={googleMapsHref(place.data)}
              search={[
                place.data.title,
                neighborhoodName(place.data.neighborhood),
                ...(place.data.address ?? []),
                ...place.data.cuisine,
                hasBody(place) ? excerpt(place.body, 120) : '',
              ]
                .filter(Boolean)
                .join(' ')}
              attrs={{
                'data-cuisine': place.data.cuisine.join('|'),
                'data-group': groupKey,
                'data-sort-name': place.data.title.toLowerCase(),
                'data-sort-verdict': `${rankLetter}|${place.data.title.toLowerCase()}`,
              }}>
              {(place.data.cuisine.length > 0 || place.data.neighborhood) && (
                <span class="eyebrow eyebrow--muted" slot="eyebrow">
                  {[
                    ...place.data.cuisine.map((cuisine) => cuisineLabel(cuisine)),
                    neighborhoodName(place.data.neighborhood),
                  ]
                    .filter(Boolean)
                    .map((part, partIndex) => (
                      <>
                        {partIndex > 0 && <span class="eyebrow-divider" aria-hidden="true" />}
                        {part}
                      </>
                    ))}
                </span>
              )}
              {verdict && (
                <span class="list-rating" slot="rating">
                  <Rating verdict={verdict} />
                </span>
              )}
              {place.data.description && (
                <span class="description" slot="sub">
                  {place.data.description}
                </span>
              )}
              {thumb && (
                <div
                  class="list-photo"
                  slot="photo"
                  style={`background-image: url(${thumb.src})`}
                  aria-hidden="true"
                />
              )}
              {hasBody(place) && (
                <div class="map-preview excerpt">{excerpt(place.body, PREVIEW_EXCERPT_CHARS)}</div>
              )}
            </MapRow>
          ))
        }
      </ul>
      <div class="fleur-templates" hidden>
        <span data-fleur="loved"><Rating verdict="loved" /></span>
        <span data-fleur="liked"><Rating verdict="liked" /></span>
        <span data-fleur="neutral"><Rating verdict="neutral" /></span>
        <span data-fleur="not-for-me"><Rating verdict="not-for-me" /></span>
      </div>
    </article>
    <CityMap
      spots={mapSpots}
      areas={areas}
      legend={cuisineLegendItems(cuisines)}
      legendFacet="cuisine"
      rowTarget="spot"
      label="Map of food spots"
    />
  </FilterMapPage>
</BaseLayout>

<script>
  import { initListGroups } from '../../scripts/list-groups'

  initListGroups()
</script>
