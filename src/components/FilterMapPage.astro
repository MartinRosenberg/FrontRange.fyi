---
import ClearFilters from './ClearFilters.astro'

interface Props {
  emptyText: string
}

const { emptyText } = Astro.props
---

<div class="map-split" data-filter-root data-map-split data-view="map">
  <div class="results">
    <slot />
    <p class="empty" data-filter-empty hidden>
      {emptyText}
      <ClearFilters />
    </p>
  </div>
</div>

<script>
  import { initMapPage } from '../scripts/views'
  initMapPage()
</script>
