---
import { href } from '../lib/url'
import { INSTAGRAM_HANDLE } from '../lib/site'

interface Props {
  trackAs?: string
}

const { trackAs } = Astro.props
const profileHref = `https://www.instagram.com/${INSTAGRAM_HANDLE}/`
---

{
  INSTAGRAM_HANDLE && (
    <a
      class="instagram-profile"
      href={profileHref}
      target="_blank"
      rel="noopener"
      data-goatcounter-click={trackAs}>
      <span class="avatar-ring">
        <img src={href('/avatar.svg')} alt="" width="48" height="48" />
      </span>
      <span class="instagram-profile-text">
        <span class="instagram-handle">@{INSTAGRAM_HANDLE}</span>
        <span class="instagram-cta">on Instagram</span>
      </span>
      <span class="btn btn-dark instagram-follow">Follow</span>
    </a>
  )
}

<style>
  .instagram-profile {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    color: var(--color-text);
    text-decoration: none;
  }

  .instagram-profile-text {
    display: grid;
    flex: 1;
    min-width: 0;
  }

  .instagram-handle {
    font-family: var(--font-sans-serif);
    font-size: var(--font-size-md);
    font-weight: 700;
  }

  .instagram-cta {
    font-family: var(--font-serif);
    font-size: var(--font-size-sm);
    color: var(--color-muted);
  }

  .instagram-profile:hover .instagram-handle {
    text-decoration: underline;
  }

  .instagram-follow {
    padding: var(--spacing-xs) var(--spacing-md);
    font-size: var(--font-size-sm);
    font-weight: 700;
    text-transform: none;
  }
</style>
