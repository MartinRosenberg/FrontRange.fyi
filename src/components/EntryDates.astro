---
import { formatDate, isoDate } from '../lib/dates'

interface Props {
  created?: Date
  updated?: Date
}

const { created, updated } = Astro.props
const revisedAfterWriting =
  created && updated && created.valueOf() !== updated.valueOf() ? { created, updated } : undefined
const single = updated ?? created
---

{
  revisedAfterWriting ? (
    <Fragment>
      Written{' '}
      <time class="dt-published" datetime={isoDate(revisedAfterWriting.created)}>
        {formatDate(revisedAfterWriting.created)}
      </time>{' '}
      and updated on{' '}
      <time class="dt-updated" datetime={isoDate(revisedAfterWriting.updated)}>
        {formatDate(revisedAfterWriting.updated)}
      </time>
    </Fragment>
  ) : (
    single && (
      <Fragment>
        Last updated{' '}
        <time class="dt-updated" datetime={isoDate(single)}>
          {formatDate(single)}
        </time>
        {created && updated && (
          <time class="dt-published" datetime={isoDate(created)} hidden>
            {formatDate(created)}
          </time>
        )}
      </Fragment>
    )
  )
}
