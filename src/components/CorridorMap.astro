---
import BadgeIcons from './BadgeIcons.astro'
import type { CorridorSpot } from '../lib/corridor-spots'

interface Props {
  spots: Record<string, CorridorSpot[]>
}

const { spots } = Astro.props
---

<BadgeIcons />

<script type="application/json" data-corridor-spots set:html={JSON.stringify(spots)} />

<script>
  import { initCorridorMaps } from '../scripts/corridor-map'
  initCorridorMaps()
</script>
