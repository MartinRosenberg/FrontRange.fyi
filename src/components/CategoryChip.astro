---
import Icon from './Icon.astro'
import { spotCategories, type SpotCategoryKey } from '../lib/spots'

interface Props {
  category: SpotCategoryKey
  label?: string
  labelHidden?: boolean
  count?: number
  size?: 'sm' | 'lg'
  href?: string
  as?: 'span' | 'label' | 'li'
}

const {
  category,
  label,
  labelHidden = false,
  count,
  size = 'sm',
  href: linkHref,
  as: element = 'span',
} = Astro.props
const meta = spotCategories[category]
const Tag = linkHref ? 'a' : element
---

<Tag
  class:list={['chip', 'category-chip', { 'category-chip--lg': size === 'lg' }]}
  href={linkHref}
  style={`--badge-color: var(${meta.token})`}>
  <slot />
  <span class="map-legend-swatch" aria-hidden="true">
    <Icon name={meta.icon} />
  </span>
  {count !== undefined && <span class="count">{count}</span>}
  {label && <span class:list={{ 'visually-hidden': labelHidden }}>{label}</span>}
</Tag>
