---
import SuggestSpot from './SuggestSpot.astro'
import IconMenu from '../assets/IconMenu.astro'

interface Props {
  label: string
}

const { label } = Astro.props
---

<div class="map-actions">
  <button type="button" class="map-split-toggle" data-map-split-toggle>
    <span class="map-split-toggle-icon" aria-hidden="true">
      <IconMenu />
    </span>
    <span data-map-split-label>{label}</span>
  </button>
  <SuggestSpot />
</div>
