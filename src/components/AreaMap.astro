---
import { CITY } from '../lib/site'
import MapLegend from './MapLegend.astro'
import { spotCategories, type MapSpot, type SpotCategoryKey } from '../lib/spots'

interface Props {
  spots: MapSpot[]
}

const { spots } = Astro.props
const legendCategories = (Object.keys(spotCategories) as SpotCategoryKey[]).filter((key) =>
  spots.some((spot) => spot.category === key),
)
---

<div
  class="area-map"
  data-area-map
  role="application"
  aria-label={`Map of ${CITY} neighborhoods — click a neighborhood to jump to it`}>
  <MapLegend categories={legendCategories} off={['food']} />
</div>
<script is:inline type="application/json" data-area-map-spots set:html={JSON.stringify(spots)} />

<button type="button" class="map-split-toggle btn-dark" data-map-split-toggle>View map</button>

<script>
  import { initAreaMap } from '../scripts/area-map'
  initAreaMap()

  const split = document.querySelector('[data-map-split]')
  const toggle = document.querySelector('[data-map-split-toggle]')

  function updateToggleLabel(): void {
    const showingMap = split?.getAttribute('data-view') === 'map'
    if (toggle) {
      toggle.textContent = showingMap ? 'View list' : 'View map'
    }
  }

  toggle?.addEventListener('click', () => {
    const nextView = split?.getAttribute('data-view') === 'map' ? 'list' : 'map'
    split?.setAttribute('data-view', nextView)
    updateToggleLabel()
  })

  updateToggleLabel()
</script>
