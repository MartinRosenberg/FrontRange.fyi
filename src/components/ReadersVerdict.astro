---
import IconThumbsUp from '../assets/IconThumbsUp.astro'
import { SUPABASE_ENABLED } from '../lib/site'
import IconThumbsDown from '../assets/IconThumbsDown.astro'

interface Props {
  slug: string
  title: string
  compact?: boolean
}

const { slug, title, compact = false } = Astro.props

const readersEnabled = SUPABASE_ENABLED
---

{
  readersEnabled && (
    <section
      class:list={[compact ? 'verdict-row' : 'verdict-bar pane-stat']}
      data-readers-verdict
      data-slug={slug}
      aria-label={`Rate ${title}`}>
      <span class:list={[{ 'pane-stat-label': !compact }, 'eyebrow eyebrow--muted']}>Your rating</span>
      <div class:list={['rv-pill', { 'rv-pill--split': compact }]}>
        <button
          type="button"
          class="rv-choice btn btn-outline btn-compact btn-muted-icon"
          data-vote="like"
          aria-pressed="false"
          aria-label="I liked it"
          disabled>
          <IconThumbsUp />
          {!compact && 'Liked'}
          <span class="rv-count" data-count-like />
        </button>
        <button
          type="button"
          class="rv-choice btn btn-outline btn-compact btn-muted-icon"
          data-vote="dislike"
          aria-pressed="false"
          aria-label="Not for me"
          disabled>
          <IconThumbsDown />
          {!compact && 'Not for me'}
          <span class="rv-count" data-count-dislike />
        </button>
      </div>
      <p class="rv-vote-status form-status" data-vote-status role="status" aria-live="polite" />
    </section>
  )
}

<style>
  .verdict-bar {
    margin: 0;
  }

  .rv-pill {
    display: inline-flex;
    gap: var(--spacing-sm);
    margin-block-start: auto;
  }

  .rv-choice {
    font-size: var(--font-size-xs);
    line-height: 1.3;
    border-radius: var(--radius-pill);

    &:disabled {
      cursor: default;
    }
  }

  .rv-choice:not(.is-active) {
    background: var(--color-background);
  }

  .rv-choice:not(:disabled, .is-active):hover {
    background: var(--color-wash);
  }

  .rv-count {
    font-variant-numeric: tabular-nums;
    color: var(--color-muted);

    &:empty {
      display: none;
    }
  }

  .rv-choice.is-active .rv-count {
    color: inherit;
  }

  .rv-vote-status {
    margin-block-start: var(--spacing-xs);
  }

  .verdict-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-sm);
    padding-block-start: var(--spacing-md);
    border-block-start: 1px dotted var(--color-line-input);

    .rv-vote-status {
      flex-basis: 100%;
      margin: 0;

      &:empty {
        display: none;
      }
    }
  }

  .rv-pill--split {
    gap: 0;
    margin: 0;

    .rv-choice {
      border-radius: 0;
      padding-inline: var(--spacing-md);
    }

    .rv-choice:first-child {
      border-start-start-radius: var(--radius-pill);
      border-end-start-radius: var(--radius-pill);
    }

    .rv-choice:last-child {
      border-inline-start-width: 0;
      border-start-end-radius: var(--radius-pill);
      border-end-end-radius: var(--radius-pill);
    }
  }
</style>
