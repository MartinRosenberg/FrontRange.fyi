---
import IconArrowLeft from '../assets/IconArrowLeft.astro'
import { href } from '../lib/url'

interface Props {
  to: string
  label: string
}

const { to, label } = Astro.props
---

<p class="back-navigation">
  <a class="continue-link" href={href(to)}>
    <IconArrowLeft />
    {label}
  </a>
</p>
