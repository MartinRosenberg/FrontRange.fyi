---
import { getCollection } from 'astro:content'
import { published } from '../lib/content'
import { SUPABASE_ENABLED } from '../lib/site'
import PanelHeading from './PanelHeading.astro'

const title = 'Reader Favorites'
const maxRows = 10
const readersEnabled = SUPABASE_ENABLED

const food = published(await getCollection('food'))
const placeTitles = Object.fromEntries(food.map((place) => [place.id, place.data.title]))
---

{
  readersEnabled && (
    <section
      class="reader-favorites"
      data-reader-favorites
      data-max-rows={maxRows}
      aria-label={title}
      hidden>
      <PanelHeading title={title} />
      <ol class="divided-list" data-favorites-list />
      <p class="reader-favorites-empty description" data-favorites-empty hidden>
        No reader votes yet.
      </p>
      <script
        is:inline
        type="application/json"
        data-place-titles
        set:html={JSON.stringify(placeTitles)}
      />
    </section>
  )
}

<script>
  import { initReaderFavorites } from '../scripts/reader-favorites'
  initReaderFavorites()
</script>

<style>
  .reader-favorites :global(li) {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr) auto;
    align-items: baseline;
    column-gap: var(--spacing-sm);
    padding-block: var(--spacing-xs);
  }

  .reader-favorites :global(.rank) {
    font-size: var(--font-size-xs);
    text-align: end;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  :global(.reader-favorites a) {
    min-width: 0;
    font-size: var(--font-size-md);
    color: var(--color-text-heading);
    text-decoration: none;
  }

  .reader-favorites :global(.fav-count) {
    font-size: var(--font-size-xs);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--color-muted);
  }

  .reader-favorites-empty {
    margin: var(--spacing-sm) 0 0;
    text-align: center;
  }
</style>
