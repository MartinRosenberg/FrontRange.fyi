---
import { FEEDBACK_ENDPOINT, SITE_NAME } from '../lib/site'

interface Props {
  subject: string
}

const { subject } = Astro.props
---

{
  FEEDBACK_ENDPOINT && (
    <form class="feedback-form form-stack" method="POST" action={FEEDBACK_ENDPOINT}>
      <label class="field">
        <span>Your note</span>
        <textarea name="message" rows="6" required />
      </label>

      <label class="field">
        <span>Name</span>
        <input type="text" name="name" autocomplete="name" />
      </label>

      <label class="field">
        <span>
          Email <span class="optional">(optional)</span>
        </span>
        <input type="email" name="email" autocomplete="email" />
      </label>

      <input type="hidden" name="_subject" value={`${SITE_NAME} ${subject}`} />

      <p class="hp" aria-hidden="true">
        <label>
          Leave this field empty
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
        </label>
      </p>

      <div class="form-actions">
        <button type="submit" class="btn btn-dark btn-compact">
          Send
        </button>
        <span class="form-status" data-form-status role="status" aria-live="polite" />
      </div>
    </form>
  )
}

<style>
  .feedback-form {
    margin-bottom: var(--spacing-md);
  }

  .optional {
    font-size: var(--font-size-xs);
    color: var(--color-muted);
    font-family: var(--font-serif);
    text-transform: none;
  }

  input[name='email'],
  input[name='name'] {
    max-width: 22rem;
  }
</style>

<script>
  import { bindFeedbackForm } from '../scripts/feedback-form'

  const form = document.querySelector<HTMLFormElement>('.feedback-form')
  const status = form?.querySelector<HTMLElement>('[data-form-status]')

  if (form && status) {
    bindFeedbackForm(form, status)
  }
</script>
