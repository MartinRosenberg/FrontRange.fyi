---
interface Props {
  title: string
  titlePrefix?: string
  count: number | string
  live?: boolean
}

const { title, titlePrefix, count, live = false } = Astro.props
---

<div class="list-pane-header">
  <span class="pane-left">
    <h1 class="pane-title title-caps">
      {titlePrefix && <span class="visually-hidden">{titlePrefix}</span>}
      {title}
    </h1>
    <span class="count">{live ? <span data-filter-count>{count}</span> : count}</span>
  </span>
  <slot />
</div>

<style>
  .pane-title {
    margin: 0;
    font-size: var(--font-size-lg);
  }
</style>
