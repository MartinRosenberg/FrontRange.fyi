---
import { CITY, CORRIDORS_TOPIC_ID, REGION, SUPABASE_ENABLED } from '../../lib/site'
import { getCollection, render } from 'astro:content'
import { getImage } from 'astro:assets'
import BaseLayout from '../../layouts/BaseLayout.astro'
import AsideHeading from '../../components/AsideHeading.astro'
import Subheading from '../../components/Subheading.astro'
import Backlinks from '../../components/Backlinks.astro'
import Comments from '../../components/Comments.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import Byline from '../../components/Byline.astro'
import EntryDates from '../../components/EntryDates.astro'
import MapPane from '../../components/MapPane.astro'
import CardList from '../../components/CardList.astro'
import Card from '../../components/Card.astro'
import { href, displayUrl, rootRelative } from '../../lib/url'
import { resolveVerdict } from '../../lib/verdict'
import { cuisineLabel } from '../../lib/cuisine'
import { googleMapsHref } from '../../lib/maps'
import { spotsIn, spotCategories, groupSpots } from '../../lib/spots'
import { toMapSpots, spotPageHref, spotWebsiteHref, spotDirectionsHref } from '../../lib/map-spots'
import { published, excerpt, hasBody, META_DESCRIPTION_CHARS } from '../../lib/content'
import { getBacklinks } from '../../lib/backlinks'
import {
  foodByNeighborhood,
  neighborBearing,
  neighborhoodInfo,
  neighborhoodPopulation,
  neighborhoodGeneratedSummary,
  neighborhoodMetaDescription,
  neighborsOf,
  festivalsIn,
  corridorsIn,
  neighborhoodResourceLinks,
  regionOf,
  regionTokenBySlug,
} from '../../lib/neighborhoods'
import neighborhoods from '../../data/neighborhoods.json'
import Button from '../../components/Button.astro'
import SourceLink from '../../components/SourceLink.astro'
import FactCards from '../../components/FactCards.astro'
import IconArrowRight from '../../assets/IconArrowRight.astro'
import IconExternalLink from '../../assets/IconExternalLink.astro'
import IconChart from '../../assets/IconChart.astro'
import IconBook from '../../assets/IconBook.astro'
import IconLandmark from '../../assets/IconLandmark.astro'

const resourceIcons: Record<string, typeof IconExternalLink> = {
  Wikipedia: IconBook,
  MyTownView: IconChart,
  Website: IconExternalLink,
  'St. Louis City': IconLandmark,
}

export async function getStaticPaths() {
  const entries = published(await getCollection('neighborhoods'))
  const entryBySlug = new Map(entries.map((entry) => [entry.id, entry]))

  return neighborhoods
    .filter((neighborhood) => !('ignored' in neighborhood))
    .map((neighborhood) => ({
      params: { slug: neighborhood.slug },
      props: { entry: entryBySlug.get(neighborhood.slug) ?? null },
    }))
}

const { slug = '' } = Astro.params
const { entry } = Astro.props
const info = neighborhoodInfo(slug)
const title = info?.name ?? slug

const rendered = entry ? await render(entry) : null
const Content = rendered?.Content

const sharePhoto = entry?.data.photo
  ? await getImage({ src: entry.data.photo, width: 1200, format: 'jpeg' })
  : undefined
const hasWriteup = Boolean(entry?.body && entry.body.trim())
const backlinks = entry ? await getBacklinks(entry.id) : []
const tags = entry?.data.tags ?? []
const notes = entry?.data.notes ?? []

const spots = spotsIn(slug)

const population = neighborhoodPopulation(slug)
const neighbors =
  entry?.data.neighbors && entry.data.neighbors.length > 0
    ? entry.data.neighbors.flatMap((neighborSlug) => {
        const neighbor = neighborhoodInfo(neighborSlug)
        return neighbor ? [neighbor] : []
      })
    : neighborsOf(slug)
const festivals = festivalsIn(slug)

const walkableStLouisLive = published(await getCollection('topics')).some(
  (topic) => topic.id === CORRIDORS_TOPIC_ID,
)
const corridors = walkableStLouisLive ? corridorsIn(slug) : []

const placesByNeighborhood = await foodByNeighborhood()
const places = placesByNeighborhood.get(slug) ?? []

const writtenBySlug = new Map(
  published(await getCollection('neighborhoods')).map((neighborhoodEntry) => [
    neighborhoodEntry.id,
    Boolean(neighborhoodEntry.body && neighborhoodEntry.body.trim()),
  ]),
)

const exploredNeighbors = neighbors.filter((neighbor) => writtenBySlug.get(neighbor.slug))
const notYetVisitedNeighbors = neighbors.filter((neighbor) => !writtenBySlug.get(neighbor.slug))
const nearbyNeighbors = [...exploredNeighbors, ...notYetVisitedNeighbors].slice(0, 5)

const resourceLinks = neighborhoodResourceLinks(slug, title, entry?.data.url, entry?.data.wikipedia)

const generated = neighborhoodGeneratedSummary(slug)

const tagline = entry?.data.description
const summary = tagline ?? generated

const lastUpdated = entry ? (entry.data.updated ?? entry.data.created) : undefined

const generatedBudget = META_DESCRIPTION_CHARS - (tagline ? tagline.length + 2 : 0)
const metaDescription = hasWriteup
  ? excerpt(entry?.body, META_DESCRIPTION_CHARS)
  : [tagline, neighborhoodMetaDescription(slug, neighbors, places.length, generatedBudget)]
      .filter(Boolean)
      .join('. ')

let seoTitle: string | undefined
if (info) {
  if (info.type === 'park') {
    seoTitle = `${title} - Park in ${CITY}`
  } else if (info.type) {
    const kind = `${info.type.charAt(0).toUpperCase()}${info.type.slice(1)} in ${info.group}`
    seoTitle = `${title}, ${REGION} - ${kind}`
  } else {
    seoTitle = `${title} - Neighborhood in ${CITY}`
  }
}

const region = info ? regionOf(info) : undefined
const trail = [
  { label: 'Neighborhoods', href: '/neighborhoods/' },
  ...(region ? [{ label: region.label, href: `/neighborhoods/${region.slug}/` }] : []),
]

const isCafe = (place: (typeof places)[number]) => place.data.cuisine.includes('cafe')
const cafes = places.filter(isCafe)
const eateries = places.filter((place) => !isCafe(place))
const spotGroups = groupSpots(spots)

const mapSpots = await toMapSpots(spots, places)

const boundaryToken = regionTokenBySlug[region?.slug ?? ''] ?? '--color-map-accent'
---

<BaseLayout
  crumb={title}
  title={seoTitle}
  description={metaDescription}
  ogType="article"
  ogImage={sharePhoto ? rootRelative(sharePhoto.src) : undefined}
  ogImageWidth={sharePhoto ? Number(sharePhoto.attributes.width) : undefined}
  ogImageHeight={sharePhoto ? Number(sharePhoto.attributes.height) : undefined}>
  <div class="map-split detail-split" data-map-split data-view="map">
    <div class="results">
      <article class="content-pane detail-pane">
        <div class="detail-pane-inner">
          <Breadcrumbs trail={trail} />

          <header class="detail-pane-header">
            <h1 class="detail-pane-title title-page">{title}</h1>
            {summary && <p class="description description--lg detail-pane-tagline">{summary}</p>}
            {
              (population != null || places.length > 0 || spots.length > 0) && (
                <div class="pane-stats">
                  {population != null && (
                    <div class="pane-stat">
                      <span class="pane-stat-label eyebrow eyebrow--muted">Population</span>
                      <span class="pane-stat-value">{population.toLocaleString('en-US')}</span>
                    </div>
                  )}
                  {places.length > 0 && (
                    <div class="pane-stat">
                      <span class="pane-stat-label eyebrow eyebrow--muted">Food & Drink Discovered</span>
                      <span class="pane-stat-value">{places.length}</span>
                    </div>
                  )}
                  {spots.length > 0 && (
                    <div class="pane-stat">
                      <span class="pane-stat-label eyebrow eyebrow--muted">Points of interest</span>
                      <span class="pane-stat-value">{spots.length + places.length}</span>
                    </div>
                  )}
                  {
                    SUPABASE_ENABLED && (
                      <a class="pane-stat pane-stat-link" href="#comments" data-comments-link hidden>
                        <span class="pane-stat-label eyebrow eyebrow--muted">Comments</span>
                        <span class="pane-stat-value continue-link">
                          <span data-comments-cell-value>Leave a comment</span>
                        </span>
                      </a>
                    )
                  }
                </div>
              )
            }
          </header>

          <div class="body">
            {
              hasWriteup && Content ? (
                <Content />
              ) : (
                <div class="not-explored">
                  <p>I haven't written about {title} yet.</p>
                  <p>
                    Is there something you want to suggest here?
                    <a href={href('/contact/')}>Let me know</a>!
                  </p>
                </div>
              )
            }
            {notes.length > 0 && (
              <section class="notes">
                <Subheading level={4}>Notes</Subheading>
                <ul>
                  {notes.map((note) => (
                    <li>{note}</li>
                  ))}
                </ul>
              </section>
            )}
          </div>

          <Comments kind="neighborhood" slug={slug} title={title} />

          {
            hasWriteup && lastUpdated && (
              <Byline>
                <Fragment slot="footer-meta">
                  <EntryDates created={entry?.data.created} updated={entry?.data.updated} />
                </Fragment>
              </Byline>
            )
          }

          {
            eateries.length > 0 && (
              <CardList title="Food & Drink">
                {eateries.map((place) => (
                  <Card
                    href={hasBody(place) ? href(`/food/${place.id}/`) : undefined}
                    title={place.data.title}
                    meta={cuisineLabel(place.data.cuisine[0])}
                    description={place.data.description}
                    verdict={resolveVerdict(place.data)}
                    websiteHref={place.data.url}
                    directionsHref={googleMapsHref(place.data)}
                    mapSpot={place.data.title}
                  />
                ))}
              </CardList>
            )
          }

          {
            cafes.length > 0 && (
              <CardList title="Coffee">
                {cafes.map((place) => (
                  <Card
                    href={hasBody(place) ? href(`/food/${place.id}/`) : undefined}
                    title={place.data.title}
                    meta={cuisineLabel(place.data.cuisine[0])}
                    description={place.data.description}
                    verdict={resolveVerdict(place.data)}
                    websiteHref={place.data.url}
                    directionsHref={googleMapsHref(place.data)}
                    mapSpot={place.data.title}
                  />
                ))}
              </CardList>
            )
          }

          {
            spotGroups.map((group) => (
              <CardList title={spotCategories[group.category].label}>
                {group.spots.map((spot) => (
                  <Card
                    href={spotPageHref(spot)}
                    title={spot.name}
                    meta={spot.address ?? spotCategories[spot.category].meta}
                    description={spot.description}
                    websiteHref={spotWebsiteHref(spot)}
                    directionsHref={spotDirectionsHref(spot)}
                    mapSpot={spot.name}
                  />
                ))}
              </CardList>
            ))
          }

          {
            corridors.length > 0 && (
              <CardList title="Walkable streets">
                {corridors.map((corridor) => (
                  <Card
                    href={href(`/walkable-st-louis/#${corridor.anchor}`)}
                    title={corridor.name}
                    meta={corridor.street}
                    description={`${corridor.from} to ${corridor.to}`}
                  />
                ))}
              </CardList>
            )
          }

          {
            festivals.length > 0 && (
              <CardList title="Annual events">
                {festivals.map((festival) => (
                  <Card
                    title={festival.name}
                    meta={festival.when}
                    description={festival.blurb}
                  />
                ))}
              </CardList>
            )
          }

          <section class="pane-more">
            <Subheading>More</Subheading>
            <div class="pane-aside">
            {
              nearbyNeighbors.length > 0 && (
                <nav aria-label="Nearby neighborhoods">
                  <AsideHeading title="Nearby Neighborhoods" />
                  <div class="detail-links">
                    {nearbyNeighbors.map((neighbor) => {
                      const bearing = neighborBearing(slug, neighbor.slug)
                      const rotation = bearing === undefined ? undefined : (bearing + 270) % 360

                      return (
                        <Button
                          href={href(`/neighborhoods/${neighbor.slug}/`)}
                          variant="quiet"
                          compact={false}
                          class="btn-inline">
                          {rotation !== undefined && (
                            <span
                              class="bearing-arrow"
                              style={`--rotation: ${rotation}deg`}
                              aria-hidden="true">
                              <IconArrowRight />
                            </span>
                          )}
                          {neighbor.name}
                        </Button>
                      )
                    })}
                  </div>
                </nav>
              )
            }
            {
              resourceLinks.length > 0 && (
                <div>
                  <AsideHeading title="Links" />
                  <div class="detail-links">
                    {resourceLinks.map((link) => {
                      const Icon = resourceIcons[link.label]
                      const label = link.label === 'Website' ? displayUrl(link.href) : link.label

                      return (
                        <SourceLink
                          href={link.href}
                          label={label}
                          variant="quiet"
                          compact={false}
                          class="btn-inline">
                          {Icon && <Icon slot="icon" />}
                        </SourceLink>
                      )
                    })}
                  </div>
                </div>
              )
            }
            <FactCards tags={tags} />
            </div>
          </section>

          <footer>
            <Backlinks links={backlinks} />
          </footer>
        </div>
      </article>

      <MapPane
        slug={slug}
        boundaryToken={boundaryToken}
        coords={info?.coords}
        spots={mapSpots}
      />
    </div>
  </div>
</BaseLayout>

<style>
  .notes {
    font-size: var(--font-size-sm);
    color: var(--color-muted);
  }

  .notes ul {
    margin: 0;
    padding-inline-start: var(--spacing-md);
  }

  .detail-pane-inner {
    max-width: calc(var(--measure-reading) + 2 * var(--spacing-lg));
    margin-inline: auto;
    padding-inline: var(--spacing-lg);
  }

  .pane-more :global(.subheading) {
    margin-block: var(--spacing-xl) var(--spacing-lg);
  }

  .pane-aside {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xl);
    margin-block: 0 var(--spacing-xl);
  }

  @media (min-width: 701px) {
    .pane-aside {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-xl) var(--spacing-lg);
      align-items: start;
    }

    .pane-aside > :global(.side-card) {
      grid-column: 1 / -1;
    }
  }

  .bearing-arrow {
    display: inline-flex;
    color: var(--color-muted);
  }

  .bearing-arrow :global(.icon) {
    width: 14px;
    height: 14px;
    transform: rotate(var(--rotation));
  }
</style>
